<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Laptop TEMP MSI"
    Manufacturer="SD201826"
    Version="1.0.1"
    UpgradeCode="{4D154A9C-EAF1-4D4B-B942-0B874DF69C8C}"
    Scope="perUser">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Laptop TEMP MSI is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="Laptop TEMP MSI" Level="1">
      <ComponentGroupRef Id="ProductFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="InstallFolder" Name="Laptop TEMP MSI" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="LaptopTempMsiStartMenuFolder" Name="Laptop TEMP MSI" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="ProductFiles" Directory="InstallFolder">
      <Component Id="MainExecutable" Guid="{A2B0E760-4C6F-4E92-A7B2-8EBB1C83F172}">
        <File Id="MainExeFile" Source="$(PublishDir)\Laptop TEMP MSI.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="LaptopTempMsiStartMenuFolder" Guid="{F7D730E4-0957-47B4-AF57-A6A016B63CF4}">
      <Shortcut
        Id="StartMenuLink"
        Name="Laptop TEMP MSI"
        Target="[InstallFolder]Laptop TEMP MSI.exe"
        WorkingDirectory="InstallFolder" />
      <RemoveFolder Id="RemoveStartMenuFolder" Directory="LaptopTempMsiStartMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Laptop TEMP MSI" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="{CCAB26C0-D400-4996-885D-DB5F8C7B6B27}">
      <Shortcut
        Id="DesktopLink"
        Name="Laptop TEMP MSI"
        Target="[InstallFolder]Laptop TEMP MSI.exe"
        WorkingDirectory="InstallFolder" />
      <RegistryValue Root="HKCU" Key="Software\Laptop TEMP MSI" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>